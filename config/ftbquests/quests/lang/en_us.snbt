	chapter_group.3E8A1F026B5C7D91.title: "Эндгейм и Мега-Крафты"
	quest.05A676E2103DFC85.quest_desc: ["Отыщите аметистовую жеоду и создайте подзорную трубу для дальнего обзора."]
	quest.05A676E2103DFC85.title: "Аметист и подзорная труба"
	quest.05B8181D12C48AB8.quest_desc: ["Красный камень — проводник сигналов и питания для большинства механизмов."]
	quest.05B8181D12C48AB8.title: "Красная пыль"
	quest.0D2E4F6A8B0C24E6.quest_desc: ["Золотые яблоки спасают жизнь в критических битвах благодаря регенерации и поглощению урона."]
	quest.0D2E4F6A8B0C24E6.title: "Золотые плоды"
	quest.1029384756AFBECD.quest_desc: ["Деревянный сундук и бочка позволят складывать накопившийся лут и сохранять порядок на базе."]
	quest.1029384756AFBECD.title: "Базовое хранение"
	quest.1361B54CCB784EFF.quest_desc: ["Добудьте первые брёвна древесины руками или первым топором."]
	quest.1361B54CCB784EFF.title: "Первое дерево"
	quest.16F8506A5C3FAD00.quest_desc: ["Лазурит используется для чародейства и синих красителей."]
	quest.16F8506A5C3FAD00.title: "Лазурит"
	quest.17971F1FAEE2ECB1.quest_desc: ["Глубинный сланец залегает на глубинах ниже нулевой высоты и прочнее обычного камня."]
	quest.17971F1FAEE2ECB1.title: "Глубинный сланец"
	quest.18A60F5F68F91B10.quest_desc: ["Железная кирка — ключевой инструмент, открывающий доступ ко всем рудам недр."]
	quest.18A60F5F68F91B10.title: "Железная кирка: Врата в недра"
	quest.1A3B5C7D9E0F2468.quest_desc: ["Отыщите морковь и картофель в деревнях или выбейте из зомби для полноценного рациона."]
	quest.1A3B5C7D9E0F2468.title: "Корнеплоды: Морковь и Картофель"
	quest.1A9FD31F8E24306A.quest_desc: ["Создайте верстак — сердце любого крафта 3х3."]
	quest.1A9FD31F8E24306A.title: "Верстак"
	quest.1BEA5FD82A6F8384.quest_desc: ["Алмазы — вершина классического шахтёрского дела. С их помощью создаётся высший инструмент и активируются порталы."]
	quest.1BEA5FD82A6F8384.title: "Алмазы!"
	quest.1BED8100B043C1D7.quest_desc: ["Добудьте сырое железо в подземных пещерах."]
	quest.1BED8100B043C1D7.title: "Сырое железо"
	quest.1E3F5A7B9C1D35F7.quest_desc: ["Повторители и поршни — основа автоматизации, скрытых дверей и логических схем."]
	quest.1E3F5A7B9C1D35F7.title: "Редстоун-механика"
	quest.1F2E3D4C5B6A7890.quest_desc: ["Железный нагрудник и броня существенно повышают защиту от физического урона."]
	quest.1F2E3D4C5B6A7890.title: "Железная броня"
	quest.25AC9E54B4FCA21F.quest_desc: ["Шалкеровый ящик сохраняет все предметы внутри при разрушении — абсолютный триумф портативного хранения."]
	quest.25AC9E54B4FCA21F.title: "Шалкеровый ящик"
	quest.2A1B0C3D4E5F6789.quest_desc: ["Стол зачарования открывает тайные знания древних магов. Добро пожаловать в мир Ars Nouveau!"]
	quest.2A1B0C3D4E5F6789.title: "Шлюз: Магия Ars Nouveau"
	quest.2A3B4C5D6E7F8091.quest_desc: ["Алмазная кирка способна разрушить самый крепкий блок верхнего мира — обсидиан."]
	quest.2A3B4C5D6E7F8091.title: "Алмазная кирка"
	quest.2A3B4C5D6E7F8901.quest_desc: ["Железное ведро позволяет переносить жидкости, тушить огонь и создавать бесконечные источники воды."]
	quest.2A3B4C5D6E7F8901.title: "Ведро воды"
	quest.2B4C6D8E0F1A3579.quest_desc: ["Ножницы позволяют безопасно стричь овец и собирать листву."]
	quest.2B4C6D8E0F1A3579.title: "Ножницы и шерсть"
	quest.2C1B4A5D6E709281.quest_desc: ["Распилите брёвна на доски и настругайте палок для создания первых рукояток инструментов."]
	quest.2C1B4A5D6E709281.title: "Доски и палки"
	quest.2E1094F9A6C84310.quest_desc: ["Щит спасет от стрел скелетов и взрывов криперов."]
	quest.2E1094F9A6C84310.title: "Щит"
	quest.2F4A6C8E0B2D4F68.quest_desc: ["Адский нарост растет на песке душ и служит основой для подавляющего большинства зелий."]
	quest.2F4A6C8E0B2D4F68.title: "Алхимия и Адский нарост"
	quest.37B5C824E0198A2F.quest_desc: ["Добыв кварц в Нижнем мире и кремний, вы готовы к созданию цифровой МЭ-сети Refined Storage!"]
	quest.37B5C824E0198A2F.title: "Шлюз: Сети Refined Storage"
	quest.384F9A105B8C1D90.quest_desc: ["Добудьте обсидиан при помощи алмазной кирки. Он потребуется для рамки портала в Нижний мир и стола зачарования."]
	quest.384F9A105B8C1D90.title: "Обсидиан"
	quest.3A5C7E90B2D4F6A8.quest_desc: ["Древние обломки скрываются в глубинах лавовых озёр Нижнего мира. Переплавьте их в незеритовый лом!"]
	quest.3A5C7E90B2D4F6A8.title: "Древние обломки"
	quest.3B4C5D6E7F890123.quest_desc: ["Ведро лавы служит отличным сверхдолгим топливом для печи и источником обсидиана."]
	quest.3B4C5D6E7F890123.title: "Ведро лавы"
	quest.3B5C7D9E1A2F4082.quest_desc: ["Деревянная кирка — ваш первый примитивный инструмент для добычи камня."]
	quest.3B5C7D9E1A2F4082.title: "Деревянная кирка"
	quest.3C5D7E9F1A2B4680.quest_desc: ["Скрафтите удочку для ловли рыбы, полезных сокровищ и зачарованных книг."]
	quest.3C5D7E9F1A2B4680.title: "Рыбалка"
	quest.40B2389C5E1F4FC0.quest_desc: ["Добудьте булыжник деревянной киркой."]
	quest.40B2389C5E1F4FC0.title: "Булыжник"
	quest.41DF79A9BE6E1780.quest_desc: ["Переплавьте сырое железо в прочные слитки."]
	quest.41DF79A9BE6E1780.title: "Железные слитки"
	quest.4430352AB5FE48B5.quest_desc: ["Андезитовый сплав — основа шестерней, валов и кинетических механизмов Create."]
	quest.4430352AB5FE48B5.title: "Андезитовый сплав"
	quest.4430352AB5FE48B6.quest_desc: ["Андезитовый сплав готов! Теперь вам полностью открыта глава Create."]
	quest.4430352AB5FE48B6.title: "Шлюз: Инженерия Create"
	quest.44EE0D7D48747E7F.quest_desc: ["Печь необходима для выплавки руды и приготовления пищи."]
	quest.44EE0D7D48747E7F.title: "Печь"
	quest.44F78B45E12E9901.quest_desc: ["Добудьте первые брёвна древесины руками или первым топором."]
	quest.44F78B45E12E9901.title: "Первое дерево"
	quest.4A5B6C7D8E9F0123.quest_desc: ["Костёр позволяет готовить пищу до 4 порций одновременно без затрат угля, а также служит ориентиром."]
	quest.4A5B6C7D8E9F0123.title: "Тёплый костёр"
	quest.4B6D8F01C3E5A7B9.quest_desc: ["Объедините 4 незеритовых лома и 4 золотых слитка для создания незеритового слитка — вершины земной металлургии."]
	quest.4B6D8F01C3E5A7B9.title: "Незеритовый слиток"
	quest.4C2AF1950255410E.quest_desc: ["Каменная кирка позволяет добывать железо, медь и уголь."]
	quest.4C2AF1950255410E.title: "Каменная кирка"
	quest.4C5D6E7F89012345.quest_desc: ["Наковальня позволяет накладывать чары, чинить инструменты и переименовывать предметы."]
	quest.4C5D6E7F89012345.title: "Наковальня"
	quest.4D6E8F0A2B4C6E80.quest_desc: ["Кости скелетов перемалываются в костную муку для мгновенного ускорения роста растений."]
	quest.4D6E8F0A2B4C6E80.title: "Охота: Кости скелетов"
	quest.4F657525624E2004.quest_desc: ["Скрафтите лук и запас стрел для эффективной дальней охоты и обороны."]
	quest.4F657525624E2004.title: "Охота: Лук и стрелы"
	quest.5A8C11099E010001.quest_desc: ["Добро пожаловать в гильдию охотников! Великие чудовища терзают этот мир. Сразите их, чтобы заслужить несметные богатства и признание."]
	quest.5A8C11099E010001.title: "Гильдия Охотников на Боссов"
	quest.5A8C11099E010002.quest_desc: ["Древнее чудовище из расплавленного незерита обитает в глубинах Незера. Разбейте его тяжелую броню и заберите его клинок!"]
	quest.5A8C11099E010002.title: "Незеритовая Монструозность"
	quest.5A8C11099E010003.quest_desc: ["Огненный рыцарь в цитадели Незера. Он не ведает пощады и сжигает все живое адским огнем."]
	quest.5A8C11099E010003.title: "Игнис — Владыка Преисподней"
	quest.5A8C11099E010004.quest_desc: ["Древний механический страж из визерита, вооруженный лазерными пушками и ЭМИ-снарядами."]
	quest.5A8C11099E010004.title: "Предвестник (The Harbinger)"
	quest.5A8C11099E010005.quest_desc: ["Ужас подводных глубин и древних океанских капищ. Его клешни сокрушают корабли."]
	quest.5A8C11099E010005.title: "Левиафан Бездны"
	quest.5A8C11099E010006.quest_desc: ["Гигантский саркофаг и титан песков, покоящийся в священных гробницах пустыни."]
	quest.5A8C11099E010006.title: "Древний Ревенант (Ancient Remnant)"
	quest.5A8C11099E010007.quest_desc: ["Окончательный колосс Пустоты в глубинах измерений Энда. Заберите его Ядро Пустоты!"]
	quest.5A8C11099E010007.title: "Страж Края (Ender Guardian)"
	quest.5A8C11099E010008.quest_desc: ["Гигантская бронированная змея в каменном дворе Сумеречного Леса. Сбейте её чешуйки!"]
	quest.5A8C11099E010008.title: "Нага — Змей Лабиринта"
	quest.5A8C11099E010009.quest_desc: ["Некромант на вершине обсидиановой башни, защищенный щитами иллюзий."]
	quest.5A8C11099E010009.title: "Сумеречный Лич"
	quest.5A8C11099E010010.quest_desc: ["Многоголовое чудовище в дымящемся болоте. Срубите все головы и соберите огненную кровь!"]
	quest.5A8C11099E010010.title: "Огнедышащая Гидра"
	quest.5A8C11099E010011.quest_desc: ["Плачущий титан над облаками темного леса. Уничтожьте его и карминитовые механизмы."]
	quest.5A8C11099E010011.title: "Ур-Гаст Тёмной Башни"
	quest.5A8C11099E010012.quest_desc: ["Повелительница вечного льда на сияющем ледяном пике ледника."]
	quest.5A8C11099E010012.title: "Снежная Королева"
	quest.5A8C11099E010013.quest_desc: ["Каменный исполин, оживленный коралловым проклятием океанских бездн."]
	quest.5A8C11099E010013.title: "Кораллоссус (Coralssus)"
	quest.5A8C11099E010014.quest_desc: ["Проклятый рыцарь Пустоты, охраняющий тайны древней магии."]
	quest.5A8C11099E010014.title: "Маледиктус — Призрачный Паладин"
	quest.5A8C11099E010015.quest_desc: ["Огромные парящие галеоны пиратов бороздят небеса. Возьмите их на абордаж!"]
	quest.5A8C11099E010015.title: "Летучие Корабли Пиратов (Corsair's Gale)"
	quest.5A8C11099E010016.quest_desc: ["Многоярусный восточный храм в горах, охраняемый древними воинами."]
	quest.5A8C11099E010016.title: "Священный Храм Сиракава"
	quest.5A8C11099E010017.quest_desc: ["Индустриальная мега-структура с механизмами, шестернями и огнеметными ловушками."]
	quest.5A8C11099E010017.title: "Заброшенный Завод (The Foundry)"
	quest.5A8C11099E010018.quest_desc: ["Вершина архитектуры небес. Дворец над самыми высокими облаками с сундуками богов."]
	quest.5A8C11099E010018.title: "Небесный Замок (Heavenly Challenger)"
	quest.5A8C11099E010019.quest_desc: ["Процедурные многоэтажные катакомбы уходят глубоко под землю. Запаситесь факелами и зельями!"]
	quest.5A8C11099E010019.title: "Спуск в Подземелья (Dungeon Crawl)"
	quest.5A8C11099E010020.quest_desc: ["Начиная с 3-го яруса монстры появляются в зачарованной броне. Будьте предельно осторожны!"]
	quest.5A8C11099E010020.title: "Глубинные Этажи Катакомб"
	quest.5A8C11099E010021.quest_desc: ["Дно катакомб скрывает главный сундук с древними реликвиями."]
	quest.5A8C11099E010021.title: "Сокровищница Лабиринта"
	quest.5A8C11099E020001.quest_desc: ["Орудия крупного калибра незаменимы для защиты летающих крепостей Create Aeronautics! Получите инструмент литейщика."]
	quest.5A8C11099E020001.title: "Артиллерийское Бюро"
	quest.5A8C11099E020002.quest_desc: ["Используйте литейные формы и расплавленный чугун/бронзу в литейном бассейне для отливки заготовок стволов."]
	quest.5A8C11099E020002.title: "Литьё стволов в формах"
	quest.5A8C11099E020003.quest_desc: ["Стволы после литья имеют неровности. Установите расточный бур с вращением Create, чтобы нарезать нарезы калибра!"]
	quest.5A8C11099E020003.title: "Расточный станок стволов"
	quest.5A8C11099E020004.quest_desc: ["Ствол без затвора разорвет пороховыми газами! Изготовьте скользящий или винтовой казённик для заряжания."]
	quest.5A8C11099E020004.title: "Казённая часть и поршневой затвор"
	quest.5A8C11099E020005.quest_desc: ["Установите орудие на вращающийся лафет. Теперь им можно целиться вручную или запитать от приводов Create!"]
	quest.5A8C11099E020005.title: "Орудийный лафет и турель дирижабля"
	quest.5A8C11099E020006.quest_desc: ["Изготовьте цельные ядра, фугасные и бронебойные снаряды. Заряжайте пороховые заряды сзади снаряда!"]
	quest.5A8C11099E020006.title: "Тяжёлые артиллерийские снаряды"
	quest.5A8C11099E020007.quest_desc: ["Скорострельная автоматическая пушка, идеальная для истребителей и дирижаблей Aeronautics."]
	quest.5A8C11099E020007.title: "Автопушка для воздушных боёв"
	quest.5A8C11099E020008.quest_desc: ["Барабан подает снаряды со скоростью сотен выстрелов в минуту. Зарядите патронную ленту!"]
	quest.5A8C11099E020008.title: "Барабанный контейнер боеприпасов"
	quest.5A8C11099E020009.quest_desc: ["Оснастите ваш дирижабль батареей из тяжёлых орудий и автопушек. Полное господство в воздухе гарантировано!"]
	quest.5A8C11099E020009.title: "Линкор Небес (Create Dreadnought)"
	quest.5A8C11099E020010.quest_desc: ["Орудие навесного огня для обстрела вражеских крепостей через горы и стены."]
	quest.5A8C11099E020010.title: "Осадная Мортира (Mortar)"
	quest.5A8C11099E020011.quest_desc: ["Мины взрываются сверху, накрывая огромную площадь осколками."]
	quest.5A8C11099E020011.title: "Мортирные мины и разрывные снаряды"
	quest.5A8C11099E020012.quest_desc: ["Настройте время или дистанцию подрыва снаряда: ударный (Impact), таймерный (Timed), бесконтактный (Proximity)."]
	quest.5A8C11099E020012.title: "Взрыватели снарядов (Fuzes)"
	quest.5A8C11099E020013.quest_desc: ["Автоматизируйте заряжание тяжелых снарядов и пороховых картузов прямо с конвейера!"]
	quest.5A8C11099E020013.title: "Механический Досылатель Снарядов"
	quest.5A8C11099E020014.quest_desc: ["Спарка из двух автопушек с ленточным питанием сметает любых летающих драконов и монстров."]
	quest.5A8C11099E020014.title: "Зенитный Комплекс ПВО"
	quest.5A8C11099E020015.quest_desc: ["Чугун прочнее бронзы и позволяет создавать тяжелые орудийные стволы с повышенным давлением пороха."]
	quest.5A8C11099E020015.title: "Чугунное Литьё (Cast Iron)"
	quest.5A8C11099E020016.quest_desc: ["Высший класс артиллерийской стали. Выдерживает стрельбу сверхмощными бронебойными зарядами без риска разрыва ствола."]
	quest.5A8C11099E020016.title: "Стальные Стволы (Steel Cannons)"
	quest.5A8C11099E020017.quest_desc: ["Спиральные нарезы внутри канала ствола придают снаряду гироскопическое вращение, увеличивая дальность стрельбы в разы."]
	quest.5A8C11099E020017.title: "Нарезные Стволы (Rifled Barrels)"
	quest.5A8C11099E020018.quest_desc: ["Гасит отдачу тяжелых орудий на дирижабле, предотвращая раскачивание корпуса судна в полете."]
	quest.5A8C11099E020018.title: "Надульный Тормоз-Компенсатор"
	quest.5A8C11099E020019.quest_desc: ["Снаряды, начиненные сотнями свинцовых шариков. Идеальны против стай фантомов и воздушных пиратов."]
	quest.5A8C11099E020019.title: "Картечь и Шрапнель (Shrapnel)"
	quest.5A8C11099E020020.quest_desc: ["Заливают корабли врагов расплавленным фосфором и огнем, вызывая катастрофические пожары."]
	quest.5A8C11099E020020.title: "Зажигательные снаряды (Incendiary)"
	quest.5A8C11099E020021.quest_desc: ["Сформируйте батарею из 8 дальнобойных орудий и автопушек. Теперь ваша небесная армада не знает равных!"]
	quest.5A8C11099E020021.title: "Артиллерийский Корпус Адмирала"
	quest.5A8C11099E030001.quest_desc: ["Вкусная и сытная еда восстанавливает силы, накладывает сытость и ускоряет лечение. Сделайте первый поварской нож!"]
	quest.5A8C11099E030001.title: "Кулинарный Мастер"
	quest.5A8C11099E030002.quest_desc: ["Разрезайте мясо, овощи, рыбу и хлеб на разделочной доске ножом. Получайте солому из травы и филе из рыбы."]
	quest.5A8C11099E030002.title: "Разделочная доска"
	quest.5A8C11099E030003.quest_desc: ["Механический нож Create Slice & Dice автоматизирует разделку на конвейерной ленте без участия игрока!"]
	quest.5A8C11099E030003.title: "Автоматическая нарезка (Slice & Dice)"
	quest.5A8C11099E030004.quest_desc: ["Плита дарит постоянное тепло без риска сжечь поварню. На ней можно жарить одновременно до 6 кусочков мяса!"]
	quest.5A8C11099E030004.title: "Кухонная плита"
	quest.5A8C11099E030005.quest_desc: ["Установите котелок на плиту или костер. Он позволяет варить наваристые супы, рагу, пасту и тушёное мясо."]
	quest.5A8C11099E030005.title: "Котелок Повара"
	quest.5A8C11099E030006.quest_desc: ["Приготовьте наваристый суп с говядиной или ароматную пасту. Накладывает эффект «Комфорт» и восстанавливает максимум голода."]
	quest.5A8C11099E030006.title: "Сытные Блюда"
	quest.5A8C11099E030007.quest_desc: ["Большие блюда, которые можно ставить на стол и есть всей гильдией: Жареная курица с гарниром, Пастуший пирог, Фаршированная тыква!"]
	quest.5A8C11099E030007.title: "Королевские Пиры (Feasts)"
	quest.5A8C11099E030008.quest_desc: ["Свежие яблочные и шоколадные пироги для долгого путешествия на дирижабле."]
	quest.5A8C11099E030008.title: "Сладкая Выпечка"
	quest.5A8C11099E030009.quest_desc: ["Выращивайте новые полезные культуры для самых изысканных рецептов."]
	quest.5A8C11099E030009.title: "Плантация: Томаты, Лук и Капуста"
	quest.5A8C11099E030010.quest_desc: ["Рис растёт прямо в воде и служит основой для гарниров, онигири и суши."]
	quest.5A8C11099E030010.title: "Рисовые Чеки"
	quest.5A8C11099E030011.quest_desc: ["Быстрый и питательный перекус прямо во время боя."]
	quest.5A8C11099E030011.title: "Гамбургеры и Фастфуд"
	quest.5A8C11099E030012.quest_desc: ["Вершина кухонного инструмента. Режет любые ингредиенты вдвое быстрее и не ломается."]
	quest.5A8C11099E030012.title: "Незеритовый Нож Шеф-Повара"
	quest.5A8C11099E030013.quest_desc: ["Нарезайте мясо на стейки, полоски бекона и фарш для изысканных блюд."]
	quest.5A8C11099E030013.title: "Мясная Разделка"
	quest.5A8C11099E030014.quest_desc: ["Филе трески и лосося для суши, роллов и запекания на костре."]
	quest.5A8C11099E030014.title: "Рыбные Деликатесы"
	quest.5A8C11099E030015.quest_desc: ["Ароматный густой суп из лесных грибов, согревающий в холодных биомах."]
	quest.5A8C11099E030015.title: "Грибной Суп в Котелке"
	quest.5A8C11099E030016.quest_desc: ["Перегнивающие остатки еды и травы создают богатую гумусом плодородную землю (Rich Soil)."]
	quest.5A8C11099E030016.title: "Органический Компост"
	quest.5A8C11099E030017.quest_desc: ["Напитки утоляют жажду и снимают негативные эффекты."]
	quest.5A8C11099E030017.title: "Горячий Шоколад и Сидр"
	quest.5A8C11099E030018.quest_desc: ["Приготовьте полный стол всех пиров Farmer's Delight: Пастуший пирог, Фаршированная тыква и Ростбиф!"]
	quest.5A8C11099E030018.title: "Гранд-Банкет Шеф-Повара"
	quest.5A8C11099E040001.quest_desc: ["Современный век требует колоссальной мощности и гибкой логистики. Исследуйте Powah, PneumaticCraft, Industrial Foregoing и Flux Networks!"]
	quest.5A8C11099E040001.title: "Эра Продвинутых Технологий"
	quest.5A8C11099E040002.quest_desc: ["Основа для всех генераторов, кабелей и батарей в моде Powah."]
	quest.5A8C11099E040002.title: "Диэлектрический корпус"
	quest.5A8C11099E040003.quest_desc: ["Преобразует материалы лазерными лучами стержней. Создавайте пылающие кристаллы, уранинит и нитро-компоненты!"]
	quest.5A8C11099E040003.title: "Сфера Заряжания (Energizing Orb)"
	quest.5A8C11099E040004.quest_desc: ["Многоблочный ядерный реактор на уранините, генерирующий миллионы FE энергии."]
	quest.5A8C11099E040004.title: "Энергетический Реактор Powah"
	quest.5A8C11099E040005.quest_desc: ["Передатчик Player Transmitter заряжает всё снаряжение и броню в инвентаре независимо от расстояния и измерения!"]
	quest.5A8C11099E040005.title: "Беспроводная Зарядка Игрока"
	quest.5A8C11099E040006.quest_desc: ["Пневматика работает на законах давления воздуха. Соберите воздушный компрессор и проложите трубы под давлением."]
	quest.5A8C11099E040006.title: "Сжатый Воздух: Компрессор"
	quest.5A8C11099E040007.quest_desc: ["Герметичная комната из стен барокамеры и клапана давления. Прессует руды и формирует новые сплавы."]
	quest.5A8C11099E040007.title: "Барокамера Высокого Давления"
	quest.5A8C11099E040008.quest_desc: ["Травление в резервуаре и УФ-засветка. Создайте полноценные материнские платы для высокоточной аппаратуры."]
	quest.5A8C11099E040008.title: "Печатные Платы (PCB)"
	quest.5A8C11099E040009.quest_desc: ["Оружие сокрушительной скорострельности, использующее сжатый воздух и бронебойные патроны."]
	quest.5A8C11099E040009.title: "Пневматический Миниган"
	quest.5A8C11099E040010.quest_desc: ["Установите экстрактор жидкости на древесину, чтобы выкачивать сырой латекс."]
	quest.5A8C11099E040010.title: "Сбор Латекса (Fluid Extractor)"
	quest.5A8C11099E040011.quest_desc: ["Перерабатывает жидкий латекс и воду в сухие пластиковые пластины для корпусов механизмов."]
	quest.5A8C11099E040011.title: "Латексный процессор и Пластик"
	quest.5A8C11099E040012.quest_desc: ["Mob Slaughter Factory автоматизирует убой мобов, добывая жидкое мясо и ценнейшую Розовую Слизь (Pink Slime)."]
	quest.5A8C11099E040012.title: "Скотобойня и Розовая Слизь"
	quest.5A8C11099E040013.quest_desc: ["Добывает редчайшие руды и минералы прямо из толщи земной коры без разрушения блоков!"]
	quest.5A8C11099E040013.title: "Орбитальный Лазерный Бур"
	quest.5A8C11099E040014.quest_desc: ["Компактные и молниеносные трубы для передачи предметов, жидкостей, энергии и газов."]
	quest.5A8C11099E040014.title: "Трубы Pipez: Скорость и Универсальность"
	quest.5A8C11099E040015.quest_desc: ["Увеличивают пропускную способность труб до десятков тысяч предметов и миллионов RF в тик!"]
	quest.5A8C11099E040015.title: "Абсолютные Улучшения Труб"
	quest.5A8C11099E040016.quest_desc: ["Избавьтесь от проводов навсегда! Создайте Flux Plug (передатчик) и Flux Point (приёмник) энергии через любые миры."]
	quest.5A8C11099E040016.title: "Flux Networks: Беспроводная Энергия"
	quest.5A8C11099E040017.quest_desc: ["Колоссальный энергетический буфер на сотни миллионов FE для стабильного питания всего вашего завода."]
	quest.5A8C11099E040017.title: "Хранилище Gargantuan Flux Storage"
	quest.5A8C11099E040018.quest_desc: ["Максимальный тир реактора. Вырабатывает десятки миллионов RF/тик для запитки гигантских фабрик."]
	quest.5A8C11099E040018.title: "Нитро-Реактор Powah (Nitro Reactor)"
	quest.5A8C11099E040019.quest_desc: ["Программируемые летающие дроны перегружают предметы, сортируют сундуки и защищают базу."]
	quest.5A8C11099E040019.title: "Автономные Логистические Дроны"
	quest.5A8C11099E040020.quest_desc: ["Инструмент, заряжаемый миллионами RF энергии. Копает области до 9x9 блоков мгновенно!"]
	quest.5A8C11099E040020.title: "Бур Бесконечности (Infinity Drill)"
	quest.5A8C11099E040021.quest_desc: ["Генерируют постоянную энергию за счет разницы температур лавы или магмы снизу и охлаждающего блока сверху."]
	quest.5A8C11099E040021.title: "Термогенераторы Powah"
	quest.5A8C11099E040022.quest_desc: ["Сжигают жидкую лаву с высокой эффективностью, выдавая огромные потоки FE."]
	quest.5A8C11099E040022.title: "Магматоры: Энергия Лавы"
	quest.5A8C11099E040023.quest_desc: ["Экологичный источник энергии от света солнца."]
	quest.5A8C11099E040023.title: "Солнечные Панели Powah"
	quest.5A8C11099E040024.quest_desc: ["Модульные батареи Powah с тирами от Starter до Nitro для хранения миллиардов энергии."]
	quest.5A8C11099E040024.title: "Энергетические Ячейки (Energy Cells)"
	quest.5A8C11099E040025.quest_desc: ["Экспонирует пустые печатные платы перед травлением в кислотной ванне."]
	quest.5A8C11099E040025.title: "УФ-Засветка плат (UV Light Box)"
	quest.5A8C11099E040026.quest_desc: ["Растворяет медь на печатных платах в подогретом растворе травителя."]
	quest.5A8C11099E040026.title: "Ванна Травления (Etching Tank)"
	quest.5A8C11099E040027.quest_desc: ["Высокотехнологичный экзоскелет, работающий на сжатом воздухе: реактивный ранец, щиты и тепловизор!"]
	quest.5A8C11099E040027.title: "Пневматическая Силовая Броня"
	quest.5A8C11099E040028.quest_desc: ["Стравливает избыточное давление, спасая трубы завода от разрушительного взрыва."]
	quest.5A8C11099E040028.title: "Предохранительный Клапан Давления"
	quest.5A8C11099E040029.quest_desc: ["Plant Gatherer автоматически собирает созревший урожай, древесину и листву на гигантской территории."]
	quest.5A8C11099E040029.title: "Автоматический Сборщик Растений"
	quest.5A8C11099E040030.quest_desc: ["Автоматически засевает грядки семенами и сажает саженцы деревьев."]
	quest.5A8C11099E040030.title: "Сеятель Полей (Plant Sower)"
	quest.5A8C11099E040031.quest_desc: ["Сканируйте любого моба в тюрьму мобов и клонируйте его за жидкий опыт (Essence)!"]
	quest.5A8C11099E040031.title: "Клонирование Существ (Mob Duplicator)"
	quest.5A8C11099E040032.quest_desc: ["Рюкзак безграничной вместимости с встроенной авто-сортировкой и зарядкой."]
	quest.5A8C11099E040032.title: "Рюкзак Бесконечности (Infinity Backpack)"
	quest.5A8C11099E040033.quest_desc: ["Мгновенная передача любых мыслимых объемов ресурсов в каждый тик сервера."]
	quest.5A8C11099E040033.title: "Улучшение Бесконечности для Труб"
	quest.5A8C11099E040034.quest_desc: ["Центральный пульт управления всей беспроводной энергетической сетью вашей империи."]
	quest.5A8C11099E040034.title: "Контроллер Сети Flux (Flux Controller)"
	quest.5A8C11099E040035.quest_desc: ["Объедините несколько хранилищ Gargantuan в бесконечную сеть питания межпространственных порталов."]
	quest.5A8C11099E040035.title: "Энергетическая Сингулярность Flux"
	quest.5A8C11099E050001.quest_desc: ["Вы покорили дирижабли, обуздали магию Ars Nouveau, построили заводы Mekanism и повергли древних боссов. Пришло время создать реликвии богов — Креативные предметы!"]
	quest.5A8C11099E050001.title: "Врата Абсолютного Могущества"
	quest.5A8C11099E050002.quest_desc: ["Бесконечный источник вращения с любой скоростью RPM и стресс-емкостью SU. Больше никаких паровых котлов и ветряков!"]
	quest.5A8C11099E050002.title: "Креативный Мотор Create"
	quest.5A8C11099E050003.quest_desc: ["Вечное сверхгорячее пламя для любых механизмов Create. Никогда не тухнет!"]
	quest.5A8C11099E050003.title: "Креативный Торт Сполоха"
	quest.5A8C11099E050004.quest_desc: ["Источник бесконечной FE энергии максимальной мощности. Питает гигантские индукционные матрицы и реакторы."]
	quest.5A8C11099E050004.title: "Креативный Энергетический Куб"
	quest.5A8C11099E050005.quest_desc: ["Бесконечный объем любой залитой жидкости или газа. Залейте тяжелую воду, пар или лаву!"]
	quest.5A8C11099E050005.title: "Креативный Резервуар Жидкостей"
	quest.5A8C11099E050006.quest_desc: ["Креативный диск для Refined Storage. Бесконечная емкость: вмещает триллионы предметов и ресурсов!"]
	quest.5A8C11099E050006.title: "Бесконечный Диск Данных RS"
	quest.5A8C11099E050007.quest_desc: ["Вы создали все величайшие реликвии и стали абсолютным богом вселенной Steampunk & Swords! Слава великому инженеру и архимагу!"]
	quest.5A8C11099E050007.title: "Повелитель Измерений (God of Steampunk)"
	quest.5A8C11099E050008.quest_desc: ["Бесконечное питание цифровой МЭ-сети без генераторов энергии."]
	quest.5A8C11099E050008.title: "Креативный Контроллер RS"
	quest.5A8C11099E050009.quest_desc: ["Мгновенная беспроводная связь между любыми измерениями через квантовые кольца."]
	quest.5A8C11099E050009.title: "Око Сингулярности (Quantum Bridge)"
	quest.5A8C11099E050010.quest_desc: ["Соберите блоки всех металлов вселенной: Медь, Цинк, Латунь, Олово, Свинец, Уран, Осмий и Незерит!"]
	quest.5A8C11099E050010.title: "Повелитель Металлов"
	quest.5A8C11099E050011.quest_desc: ["Полный гримуар со всеми глифами и высшими заклинаниями Ars Nouveau."]
	quest.5A8C11099E050011.title: "Апофеоз Магии: Архимаг"
	quest.5A8C11099E050012.quest_desc: ["Индукционная матрица Mekanism с емкостью в сотни миллиардов джоулей."]
	quest.5A8C11099E050012.title: "Квантовый Индукционный Монолит"
	quest.5A8C11099E050013.quest_desc: ["Абсолютное завершение сборки Steampunk & Swords. Вы взошли на трон повелителя вселенной!"]
	quest.5A8C11099E050013.title: "Венец Вечности (Crown of Eternity)"
	quest.5A8C11099E060001.quest_desc: ["Добро пожаловать в боевую систему Epic Fight! Клавиша [R] переключает боевой и строительный режимы. В боевом режиме вы получаете доступ к уникальным комбо-атакам и спецударам."]
	quest.5A8C11099E060001.title: "Искусство Войны (Epic Fight)"
	quest.5A8C11099E060002.quest_desc: ["Каждый взмах оружием и перекат расходует шкалу стамины (выносливости). Если выносливость иссякнет, ваш щит будет пробит!"]
	quest.5A8C11099E060002.title: "Боевая Стойка и Выносливость"
	quest.5A8C11099E060003.quest_desc: ["Щит позволяет блокировать атаки монстров. Своевременный блок прямо перед ударом активирует Парирование, выводя врага из равновесия!"]
	quest.5A8C11099E060003.title: "Глухой Блок и Парирование"
	quest.5A8C11099E060004.quest_desc: ["Перекат (Dodge) позволяет проскользнуть сквозь сокрушительные удары боссов без получения урона."]
	quest.5A8C11099E060004.title: "Мастер Уворота (Dodge)"
	quest.5A8C11099E060005.quest_desc: ["Кинжалы наносят серию стремительных ударов с высоким шансом критического урона."]
	quest.5A8C11099E060005.title: "Кинжалы: Молниеносная скорость"
	quest.5A8C11099E060006.quest_desc: ["Смертоносное оружие для любителей быстрых атак со спины."]
	quest.5A8C11099E060006.title: "Алмазные Кинжалы Ассасина"
	quest.5A8C11099E060007.quest_desc: ["Медлительные, но сокрушающие удары с широким радиусом поражения всех врагов вокруг."]
	quest.5A8C11099E060007.title: "Двуручный Меч: Мощь Титана"
	quest.5A8C11099E060008.quest_desc: ["Оружие настоящих рыцарей, рассекающее монстров надвое."]
	quest.5A8C11099E060008.title: "Алмазный Двуручник"
	quest.5A8C11099E060009.quest_desc: ["Превосходный баланс между скоростью взмаха, дальностью выпада и уроном."]
	quest.5A8C11099E060009.title: "Лонгсворд: Идеальный баланс"
	quest.5A8C11099E060010.quest_desc: ["Рыцарский меч высшего ранга."]
	quest.5A8C11099E060010.title: "Алмазный Лонгсворд"
	quest.5A8C11099E060011.quest_desc: ["Изогнутые восточные клинки с молниеносными горизонтальными разрезами."]
	quest.5A8C11099E060011.title: "Тати и Катаны: Путь Самурая"
	quest.5A8C11099E060012.quest_desc: ["Вершина мастерства фехтования."]
	quest.5A8C11099E060012.title: "Алмазный Тати"
	quest.5A8C11099E060013.quest_desc: ["Копьё держит противников на безопасной дистанции, не подпуская их к себе."]
	quest.5A8C11099E060013.title: "Копья: Дальний выпад"
	quest.5A8C11099E060014.quest_desc: ["Кулачный рукопашный бой для истинных монахов и берсерков."]
	quest.5A8C11099E060014.title: "Боевые Перчатки: Кулачный бой"
	quest.5A8C11099E060015.quest_desc: ["Легендарные реликвии, обладающие собственным разумом и душой. Заполучите первое божественное оружие!"]
	quest.5A8C11099E060015.title: "Оружие Чудес (Weapons of Miracles)"
	quest.5A8C11099E060016.quest_desc: ["Клинок, сотканный из тёмной материи. Специальная атака рассекает само пространство перед героем."]
	quest.5A8C11099E060016.title: "Антитеус — Пожиратель Звёзд"
	quest.5A8C11099E060017.quest_desc: ["Тяжелое мистическое оружие, притягивающее врагов черной дырой при спецударе."]
	quest.5A8C11099E060017.title: "Чёрная Звезда (Blackstar)"
	quest.5A8C11099E060018.quest_desc: ["Парные когти, разрывающие броню противников на части."]
	quest.5A8C11099E060018.title: "Когти Демона (Claw of Agony)"
	quest.5A8C11099E060019.quest_desc: ["Магический наруч, увеличивающий скорость комбо-атак."]
	quest.5A8C11099E060019.title: "Браслет Стремительности"
	quest.5A8C11099E060020.quest_desc: ["Маска, внушающая ужас монстрам и дарующая вампиризм в пылу сражения."]
	quest.5A8C11099E060020.title: "Проклятая Маска Войны"
	quest.5A8C11099E060021.quest_desc: ["В сундуках данжей и катакомб можно отыскать уникальные артефакты, надеваемые в слоты Curios."]
	quest.5A8C11099E060021.title: "Древние Артефакты Подземелий"
	quest.5A8C11099E060022.quest_desc: ["Даруют иммунитет к урону от падения и увеличивают высоту прыжка."]
	quest.5A8C11099E060022.title: "Сапоги-Прыгуны (Bunny Hoppers)"
	quest.5A8C11099E060023.quest_desc: ["Позволяют бегать прямо по водной глади как посуху!"]
	quest.5A8C11099E060023.title: "Водные Скороходы (Aqua Dashers)"
	quest.5A8C11099E060024.quest_desc: ["Мясной кусок, который никогда не заканчивается. Проблема с голодом решена навсегда!"]
	quest.5A8C11099E060024.title: "Вечная Говядина (Everlasting Beef)"
	quest.5A8C11099E060025.quest_desc: ["Поджигает врагов при рукопашных ударах и взмахах оружием."]
	quest.5A8C11099E060025.title: "Огненная Рукавица (Fire Gauntlet)"
	quest.5A8C11099E060026.quest_desc: ["Автоматически телепортирует героя в безопасное место при получении смертельного удара."]
	quest.5A8C11099E060026.title: "Тотем Хоруса (Chorus Totem)"
	quest.5A8C11099E060027.quest_desc: ["Особая техника быстрого извлечения клинка из ножен (Иайдо)."]
	quest.5A8C11099E060027.title: "Утигатана Самурая (Uchigatana)"
	quest.5A8C11099E060028.quest_desc: ["Пожинает души павших монстров, восстанавливая стамину владельца."]
	quest.5A8C11099E060028.title: "Синигами — Коса Смерти (Shinigami)"
	quest.5A8C11099E060029.quest_desc: ["Мистический клинок, испускающий волны лунного света при взмахе."]
	quest.5A8C11099E060029.title: "Лунный Свет (Moonlight Greatsword)"
	quest.5A8C11099E060030.quest_desc: ["Священное оружие справедливости с сияющим золотым свечением."]
	quest.5A8C11099E060030.title: "Экскалибур — Меч Королей"
	quest.5A8C11099E060031.quest_desc: ["Увеличивает добычу и шанс выпадения редчайших трофеев с боссов."]
	quest.5A8C11099E060031.title: "Шляпа Суеверий (Superstitious Hat)"
	quest.5A8C11099E060032.quest_desc: ["Позволяет парить в воздухе и плавать в небесах словно в невесомости."]
	quest.5A8C11099E060032.title: "Гелиевый Фламинго (Helium Flamingo)"
	quest.5A8C11099E060033.quest_desc: ["Бьет молнией всех атакующих вас врагов в ответном ударе."]
	quest.5A8C11099E060033.title: "Грозовой Кулон (Shock Pendant)"
	quest.5A8C11099E060034.quest_desc: ["Дарует колоссальное ускорение бега при получении урона, позволяя разорвать дистанцию."]
	quest.5A8C11099E060034.title: "Ожерелье Паники (Panic Necklace)"
	quest.5A8C11099E060035.quest_desc: ["Вы овладели всеми стилями боя, собрали легендарные артефакты и божественные клинки!"]
	quest.5A8C11099E060035.title: "Триумф Бога Войны (Ares Champion)"
	quest.5A8C11099E070001.quest_desc: ["Алхимия позволяет варить могущественные зелья усиления и защиты."]
	quest.5A8C11099E070001.title: "Варочная Стойка"
	quest.5A8C11099E070002.quest_desc: ["Сахар разгоняет метаболизм. Сварите первое зелье стремительности!"]
	quest.5A8C11099E070002.title: "Зелье Скорости"
	quest.5A8C11099E070003.quest_desc: ["Сгусток магмы делает тело невосприимчивым к лаве и адскому огню."]
	quest.5A8C11099E070003.title: "Зелье Огнестойкости"
	quest.5A8C11099E070004.quest_desc: ["Сверкающий ломтик арбуза с золотом мгновенно восстанавливает здоровье в критический момент."]
	quest.5A8C11099E070004.title: "Зелье Исцеления"
	quest.5A8C11099E070005.quest_desc: ["Маринованный паучий глаз выворачивает свойства зелья наизнанку."]
	quest.5A8C11099E070005.title: "Зелье Невидимости"
	quest.5A8C11099E070006.quest_desc: ["Стригите овец, чтобы добывать шерсть для кроватей и декораций без убийства животных."]
	quest.5A8C11099E070006.title: "Ножницы и Овцы"
	quest.5A8C11099E070007.quest_desc: ["Кожа необходима для переплёта книг, создания рюкзаков и брони."]
	quest.5A8C11099E070007.title: "Разведение Коров: Кожа"
	quest.5A8C11099E070008.quest_desc: ["Привязывайте коров, лошадей и овец или ведите их за собой в загон."]
	quest.5A8C11099E070008.title: "Поводок для животных"
	quest.5A8C11099E070009.quest_desc: ["Поставьте костер под улей и срезайте соты ножницами, не разозлив пчёл."]
	quest.5A8C11099E070009.title: "Пасека и Пчеловодство"
	quest.5A8C11099E070010.quest_desc: ["Стрелка компаса всегда указывает на точку вашего возрождения или мировой спавн."]
	quest.5A8C11099E070010.title: "Компас"
	quest.5A8C11099E070011.quest_desc: ["Позволяют ориентироваться во времени суток даже в самых глубоких темных шахтах."]
	quest.5A8C11099E070011.title: "Золотые Часы"
	quest.5A8C11099E070012.quest_desc: ["Создавайте карты неизведанных земель и расширяйте их масштаб."]
	quest.5A8C11099E070012.title: "Стол Картографа и Карты"
	quest.5A8C11099E070013.quest_desc: ["Оружие утопленников с чарами Верности или Тягуна для быстрого полета в дождь."]
	quest.5A8C11099E070013.title: "Глубинный Трезубец"
	quest.5A8C11099E070014.quest_desc: ["Дарует ночное зрение, подводное дыхание и ускорение копания под водой."]
	quest.5A8C11099E070014.title: "Морской Проводник (Conduit)"
	quest.5A8C11099E070015.quest_desc: ["Покорите небеса! Спланируйте с вершины городов Края и используйте ракеты фейерверка для бесконечного полета."]
	quest.5A8C11099E070015.title: "Крылья Элитры (Elytra)"
	quest.5A8C11099E070016.quest_desc: ["Единый персональный карманный склад, доступный из любого места и любого измерения."]
	quest.5A8C11099E070016.title: "Сундук Края (Ender Chest)"
	quest.5A8C11099E070017.quest_desc: ["Телепортирует игрока на случайную дистанцию при поедании. Служит основой для стержней Края."]
	quest.5A8C11099E070017.title: "Плод Хоруса"
	quest.5B1C2D3E4F5A6B70.quest_desc: ["Сахарный тростник растет вдоль рек и водоёмов. Он понадобится для производства сахара, бумаги и книг."]
	quest.5B1C2D3E4F5A6B70.title: "Сахарный тростник"
	quest.5C7E9012D4F6A8B0.quest_desc: ["Жемчуг Края падает со странников Края и позволяет телепортироваться на расстояния."]
	quest.5C7E9012D4F6A8B0.title: "Жемчуг Края"
	quest.5D5DB7F2FD5C3210.quest_desc: ["Постройте рамку из обсидиана и подожгите огнивом, чтобы отправиться в Нижний мир."]
	quest.5D5DB7F2FD5C3210.title: "Экспедиция в Нижний мир"
	quest.5D6E7F8A9B0C1D2E.quest_desc: ["Огненные стержни ифритов из адской крепости — источник алхимии, огненного порошка и глаз Края."]
	quest.5D6E7F8A9B0C1D2E.title: "Огненные стержни (Ифриты)"
	quest.5E5C60783F414D2A.quest_desc: ["Осмий — сердце мода Mekanism. Добудьте его для металлургических очистителей и генераторов."]
	quest.5E5C60783F414D2A.title: "Сырой осмий"
	quest.5E5C60783F414D2B.quest_desc: ["Добыв осмий, вы разблокировали доступ к ветке высоких технологий Mekanism!"]
	quest.5E5C60783F414D2B.title: "Шлюз: Индустрия Mekanism"
	quest.5E7F9A1B3C5D7F91.quest_desc: ["Нить пауков нужна для удочек, поводков, луков и шерсти."]
	quest.5E7F9A1B3C5D7F91.title: "Охота: Нить паука"
	quest.622351BC30D93F04.quest_desc: ["Медь — ключевой металл кинематики Create, проводов и паровых технологий."]
	quest.622351BC30D93F04.title: "Медная руда"
	quest.624642FD21AB7ACF.quest_desc: ["Золото необходимо для энергетики, золотых яблок и продвинутых сплавов."]
	quest.624642FD21AB7ACF.title: "Золотая руда"
	quest.6C2D3E4F5A6B7081.quest_desc: ["Переработайте тростник в бумагу и сшейте первые книги вместе с кожей."]
	quest.6C2D3E4F5A6B7081.title: "Бумага и фолианты"
	quest.6D1F5192F6A64644.quest_desc: ["Скрафтите базовый набор каменных инструментов для выживания."]
	quest.6D1F5192F6A64644.title: "Каменный арсенал"
	quest.6D8F0123E5A7B9C1.quest_desc: ["Соедините жемчуг Края и огненный порошок, чтобы получить Око Края, ведущее к крепости портала в Край."]
	quest.6D8F0123E5A7B9C1.title: "Око Края и Поиски Крепости"
	quest.6E7F8A9B0C1D2E3F.quest_desc: ["Кварц Нижнего мира — главный кристаллический компонент датчиков, компараторов и цифровых схем."]
	quest.6E7F8A9B0C1D2E3F.title: "Кварц Нижнего мира"
	quest.6EA719CEED1C4B1C.quest_desc: ["Создайте кровать, чтобы пережить ночные нападения и установить точку возрождения."]
	quest.6EA719CEED1C4B1C.title: "Первая ночь"
	quest.6F8A0B2C4D6E80A2.quest_desc: ["Порох с криперов позволяет делать динамит (TNT) и ракеты для надкрылий."]
	quest.6F8A0B2C4D6E80A2.title: "Опасность: Порох и TNT"
	quest.75BF61D8614792D6.quest_desc: ["Постройте рамку из обсидиана и подожгите огнивом, чтобы отправиться в адские пустоши Нижнего мира."]
	quest.75BF61D8614792D6.title: "Экспедиция в Нижний мир"
	quest.7A9B1C3D5E7F91B3.quest_desc: ["Переплавьте песок в прозрачное стекло для окон, колб и приборов."]
	quest.7A9B1C3D5E7F91B3.title: "Стекло и колбы"
	quest.7D8E9F0A1B2C3D4E.quest_desc: ["Объедините силу обсидиана, алмазов, лазурита и книг для создания Стола зачарования."]
	quest.7D8E9F0A1B2C3D4E.title: "Стол зачарования"
	quest.7E8F9A0B1C2D3E4F.quest_desc: ["Посадите пшеницу для выпечки питательного хлеба и разведения домашнего скота."]
	quest.7E8F9A0B1C2D3E4F.title: "Фермерство: Хлеб"
	quest.7E901234F6A8B0D2.quest_desc: ["Активируйте портал в Край, сразите Дракона Края и заберите трофейное яйцо!"]
	quest.7E901234F6A8B0D2.title: "Победа над Драконом Края"
	quest.7F5203BC5B8FC8C2.quest_desc: ["Добудьте каменный уголь для плавки и освещения."]
	quest.7F5203BC5B8FC8C2.title: "Каменный уголь"
	quest.7F804E19C6A18D34.quest_desc: ["Бросьте алмаз в заполненный водой бассейн 2х2 с цветами, чтобы открыть портал в Сумеречный Лес."]
	quest.7F804E19C6A18D34.title: "Шлюз: The Twilight Forest"
	task.3C4D5E6F7001A2B3.title: "Любые доски"
	task.3E7D63E63D08420D.title: "Любая кровать"
	task.44F78B45E12E9903.title: "Любое бревно"
}
