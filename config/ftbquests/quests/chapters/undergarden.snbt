			}]
			shape: "octagon"
			size: 1.3d
			tasks: [{
				id: "0A889EB88211B0ED"
				structure: "undergarden:catacombs"
				type: "structure"
			}]
			x: 14.0d
			y: -0.5d
					title: "Катакомбы"
			description: ["Катакомбы — огромные подземные структуры из глубинного кирпича. Иногда их часть может торчать из земли, так вы их найдёте. \\n\\nВнутри огромного лабиринта обитают &7забвенные&r, спрятаны сундуки и босс: &aЗабвенный страж&r. \\n\\nНадеюсь, ты готов к этому!"]
		}
		{
			dependencies: ["1C232674CD04024D"]
			icon: {
				id: "undergarden:grongle_sapling"
			}
			id: "647A87E800C703C3"
			rewards: [{
				id: "2DBEE0D01E6A8995"
				type: "xp_levels"
				xp_levels: 1
			}]
			shape: "hexagon"
			size: 1.2d
			tasks: [{
				biome: "undergarden:gronglegrowth"
				icon: {
					id: "undergarden:grongle_sapling"
				}
				id: "7C9EF32C628CA0A8"
				type: "biome"
			}]
			x: -5.5d
			y: -6.0d
					title: "Гронгловые заросли"
			description: [ "Мой любимый биом, безусловно! \\n\\nОгромные зелёные джунгли с гигантскими гронгловыми деревьями. \\n\\nНа этих деревьях можно найти &eгронгжуков&r!" "{image:atm:textures/questpics/undergarden/undergarden_grongle.png width:200 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "5FCA6F5FE97780B7"
			rewards: [{
				count: 7
				id: "64525F6365C40773"
				item: {
					count: 1
					id: "undergarden:gronglet"
				}
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				id: "442B73DD312E5D42"
				item: { count: 1, id: "undergarden:gronglet" }
				type: "item"
			}]
			x: -3.5d
			y: -0.5d
					title: "&eГронгжук&r"
			description: [ "&eГронгжуки&r — это технически блоки, а не мобы. Но я их слишком люблю, чтобы не упомянуть! \\n\\nОни появляются на гронгловых деревьях, издают шум и светятся! Идеально для украшения." "{image:atm:textures/questpics/undergarden/undergarden_gronglet.png width:100 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			icon: {
				id: "undergarden:glitterkelp"
			}
			id: "353AEEC116A5DEEF"
			rewards: [{
				id: "5429CC01B4971AD3"
				type: "xp_levels"
				xp_levels: 1
			}]
			shape: "hexagon"
			size: 1.2d
			tasks: [{
				biome: "undergarden:ancient_sea"
				icon: {
					id: "undergarden:glitterkelp"
				}
				id: "518049B7B94DEA7A"
				type: "biome"
			}]
			x: -5.5d
			y: -8.0d
					title: "Древнее море"
			description: [ "Древние моря — это широкие открытые моря в &2&lПодземном саду&r. \\n\\nНесмотря на загрязнения, вода безопасна для питья. \\n\\nВ воде обитают &bгвибы&r и &bгвиблинги&r. И не забудьте про блестящую водоросль!" "{image:atm:textures/questpics/undergarden/undergarden_ancient.png width:200 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "43A1BC20BB054A14"
			rewards: [{
				count: 5
				id: "740845127F7ECC4D"
