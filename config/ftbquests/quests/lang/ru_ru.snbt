	quest.0B11EAB8D76529E0.quest_desc: [
		"Активируйте портал в рамке из укрепленного глубинного сланца в Древнем Городе с помощью Сердца Глубин (Heart of the Deep), чтобы попасть в Запределье (Otherside)!"
	]
