	quests: [		{
			title: "Защита от расплавления (Fail-Safe)"
			subtitle: "Предотвращение взрыва и радиации"
			description: [
				"Если реактор перегреется или накопит 100% критического урона — он &cВЗОРВЁТСЯ&r и заразит радиацией огромную территорию на многие часы реального времени! \n\nУстановите логический адаптер на "Критический урон" и подключите редстоун к верхнему адаптеру, настроенному на "Активацию", через инвертор. При малейшей опасности реактор мгновенно аварийно заглушится (SCRAM)!",
				"{image:atm:textures/questpics/mek/example_circuit.png width:140 height:160 align:center}"
			]
