			]
			tasks: [{
				id: "4FB6BB3F61AD8D6B"
				item: { count: 1, id: "twilightforest:lich_trophy" }
				type: "item"
			}]
			x: 3.0d
			y: 1.0d
					title: "&eВызов мёртвых"
			description: ["&eБашня Лича&r — дом &eЛича&r! Битва проходит в три фазы:\\n\\nФаза 1: &eЛич&r окружает себя щитами и атакует &5эндер-жемчугом&r, который вылетает, как огненный шар гаста. Отразите их обратно в &eЛича&r, чтобы сломать его щиты! По мере разрушения щитов он будет создавать двойников, чтобы отвлечь вас.\\n\\nФаза 2: &eЛич&r меняет скипетр и призывает зомби, чтобы те помогли ему в бою. Без щитов вы сможете атаковать его в ближнем бою!\\n\\nФаза 3: Когда все заряды скипетра израсходованы, он возьмёт &eзолотой меч&r и впадёт в ярость. Убейте его быстро!"]
		}
