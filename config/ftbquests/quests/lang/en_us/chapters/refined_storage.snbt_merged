	quest.123807F4BBE75120.title: "Компонент хранения ExtraDisks 16M"
	quest.123807F4BBE75120.quest_desc: ["Компонент хранения для сборки диска хранения предметов емкостью &616 384 000&r предметов.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.4966162FBA933453.title: "Компонент хранения ExtraDisks 262M"
	quest.4966162FBA933453.quest_desc: ["Компонент хранения для сборки диска хранения предметов емкостью &6262 144 000&r предметов.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.718A2040D868E09F.title: "Компонент хранения ExtraDisks 1048M (1G)"
	quest.718A2040D868E09F.quest_desc: ["Компонент хранения для сборки диска хранения предметов емкостью &61 048 576 000&r предметов.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.7DD638E4111D66E7.title: "Улучшенный корпус диска"
	quest.7DD638E4111D66E7.quest_desc: ["&8Улучшенный корпус диска&r (Advanced Storage Housing) необходим для сборки сверхвместительных дисков &5ExtraDisks&r (от 256k до 1048M).", "", "Обычный корпус Refined Storage не подходит для многомегабайтных компонентов ExtraDisks."]
	quest.44881E39AB1D62AA.title: "Создатель (Autocrafter)"
	quest.44881E39AB1D62AA.quest_desc: ["&3Создатель&r — основа автоматизации в Refined Storage.", "", "Поместите внутрь закодированные шаблоны из &bТерминала шаблонов&r. Создатель может как выполнять крафты в верстаке (режим Крафт), так и выбрасывать ингредиенты в прилежащие печи, дробители или механизмы (режим Обработка)."]
	quest.45FF08E4DB6F7F0E.title: "Элитный создатель (Elite Crafter)"
	quest.45FF08E4DB6F7F0E.quest_desc: ["&bЭлитный создатель&r вмещает до 18 шаблонов и работает в 2 раза быстрее стандартного создателя."]
	quest.4A198E875A6B0A64.title: "Ультра-создатель (Ultra Crafter)"
	quest.4A198E875A6B0A64.quest_desc: ["&dУльтра-создатель&r вмещает до 36 шаблонов и работает в 4 раза быстрее стандартного создателя."]
	quest.189018F641FBB44E.title: "Мега-создатель (Mega Crafter)"
	quest.189018F641FBB44E.quest_desc: ["&4Мега-создатель&r вмещает до 54 шаблонов и крафтит с максимальной скоростью (в 8 раз быстрее стандартного)."]
	quest.6904EC449FBEE387.title: "Кабели МЭ-сети"
	quest.6904EC449FBEE387.quest_desc: ["&7Кабель&r связывает любые устройства Refined Storage с Контроллером.", "", "Кабели проводят и энергию, и данные сети без потерь на любое расстояние. Их можно скрывать с помощью камуфляжных панелей (Covers)."]
	quest.532229D285CA4858.title: "Импортёр (Importer)"
	quest.532229D285CA4858.quest_desc: ["&3Импортёр&r забирает предметы из прилежащего сундука, бункера или механизма и моментально отправляет их в вашу МЭ-сеть.", "", "Поддерживает фильтрацию и улучшения скорости/стака."]
	quest.6092490EC9008A05.title: "Деструктор (Destructor)"
	quest.6092490EC9008A05.quest_desc: ["&cДеструктор&r автоматически ломает блоки прямо перед собой и всасывает их в МЭ-сеть.", "", "Идеален для автоматических ферм дерева, булыжника и кристаллов. Поддерживает улучшения «Шелковое касание» и «Удача»."]
	quest.2CFEE04BA574921E.title: "Конструктор (Constructor)"
	quest.2CFEE04BA574921E.quest_desc: ["&aКонструктор&r автоматически устанавливает указанный блок из вашей МЭ-сети в пространство перед собой.", "", "Широко используется в связке с деструктором для генераторов блоков и ферм."]
	quest.4CD83943865018EA.title: "Экспортёр (Exporter)"
	quest.4CD83943865018EA.quest_desc: ["&bЭкспортёр&r выгружает указанные в фильтре предметы или жидкости из МЭ-сети в прилежащий сундук, печь или механизм.", "", "Незаменим для непрерывной подачи топлива в генераторы или сырья на переработку."]
	quest.616B6046EF5DDF21.title: "Элитный импортёр"
	quest.616B6046EF5DDF21.quest_desc: ["Импортирует предметы значительно быстрее базового, имеет расширенный фильтр."]
	quest.13A0714444BA79AB.title: "Ультра-импортёр"
	quest.13A0714444BA79AB.quest_desc: ["Импортирует до 36 слотов фильтра со встроенным ускорением."]
	quest.6D81DF90E9C2C049.title: "Элитный деструктор"
	quest.6D81DF90E9C2C049.quest_desc: ["Ломает блоки с повышенной скоростью и улучшенным фильтром."]
	quest.0D4FE97640F2CA60.title: "Ультра-деструктор"
	quest.0D4FE97640F2CA60.quest_desc: ["Мгновенно разрушает блоки с максимальной производительностью."]
	quest.6DB06E3984D0CF97.title: "Элитный конструктор"
	quest.6DB06E3984D0CF97.quest_desc: ["Устанавливает блоки с повышенной скоростью."]
	quest.1F55A483008F74FE.title: "Ультра-конструктор"
	quest.1F55A483008F74FE.quest_desc: ["Максимальная скорость установки блоков."]
	quest.6973A5923AF7BF05.title: "Элитный экспортёр"
	quest.6973A5923AF7BF05.quest_desc: ["Экспортирует предметы с увеличенной скоростью и вместительным фильтром."]
	quest.5BB7648DC10E1E08.title: "Ультра-экспортёр"
	quest.5BB7648DC10E1E08.quest_desc: ["Экспортирует любые объемы ресурсов на сверхвысокой скорости."]
	quest.4B81E84CAE814BA9.title: "Жидкостный компонент 64B"
	quest.4B81E84CAE814BA9.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &664 ведра (64 000)&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.39C8E1705EF1CD31.title: "Жидкостный компонент 256B"
	quest.39C8E1705EF1CD31.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &6256 вёдер (256 000)&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.60244F26B9ABED49.title: "Жидкостный компонент 1024B (1M)"
	quest.60244F26B9ABED49.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &61 024 ведра&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.3751015CD5C84134.title: "Жидкостный компонент 4096B (4M)"
	quest.3751015CD5C84134.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &64 096 вёдер&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.53CA0D6B4D5A17D5.title: "Жидкостный компонент ExtraDisks 16M"
	quest.53CA0D6B4D5A17D5.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &616 384 ведра&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.64D6C395B6304F40.title: "Жидкостный компонент ExtraDisks 65M"
	quest.64D6C395B6304F40.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &665 536 вёдер&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.17920C436DDBBD07.title: "Жидкостный компонент ExtraDisks 262M"
	quest.17920C436DDBBD07.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &6262 144 ведра&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.49772923B8AF0F1F.title: "Жидкостный компонент ExtraDisks 1048M"
	quest.49772923B8AF0F1F.quest_desc: ["Компонент хранения для сборки жидкостного диска емкостью &61 048 576 вёдер&r мБ жидкостей.", "", "Объедините этот компонент с &3Корпусом диска&r (Storage Housing) на верстаке, чтобы получить готовый накопитель для установки в &bДисковод МЭ-сети&r.", "", "Диски можно безопасно разбирать через Shift + ПКМ в руке, извлекая компонент обратно."]
	quest.253657BE5D9D9162.title: "Внешний накопитель (External Storage)"
	quest.253657BE5D9D9162.quest_desc: ["&3Внешний накопитель&r подключает любой обычный контейнер (сундук, бочку, ящик Sophisticated Storage, МЭ-дисковод другого мода) напрямую в вашу сеть без переноса предметов!", "", "Все предметы из сундука мгновенно становятся видны в терминале МЭ-сети."]
	quest.3B84215240D9F2CB.title: "Менеджер безопасности и Карты доступа"
	quest.3B84215240D9F2CB.quest_desc: ["&3Менеджер безопасности&r позволяет настроить права доступа для других игроков на сервере (чтение, крафт, добавление/изъятие предметов).", "", "Владелец сети всегда сохраняет полные права."]
	quest.43E8912CB307E421.title: "Терминал МЭ-сети (Grid)"
	quest.43E8912CB307E421.quest_desc: ["&3Терминал&r — основной интерфейс для доступа ко всем предметам и жидкостям, хранящимся в сети.", "", "Включает удобный поиск, сортировку по количеству/имени/модам и интеграцию с JEI/EMI."]
	quest.0F00BBDF3618B3BA.title: "Терминал создания (Crafting Grid)"
	quest.0F00BBDF3618B3BA.quest_desc: ["&3Терминал создания&r объединяет стандартный терминал МЭ-сети со встроенным верстаком 3x3.", "", "Позволяет крафтить предметы напрямую из ресурсов сети одним кликом!"]
	quest.65C8A43FEDBA3835.title: "Терминал шаблонов (Pattern Grid)"
	quest.65C8A43FEDBA3835.quest_desc: ["&3Терминал шаблонов&r записывает рецепты крафта на пустые &eШаблоны&r (Patterns).", "", "Поддерживает обычный верстачный крафт и внешнюю обработку в печах/машинах. Поддерживает быстрый перенос рецептов из JEI через кнопку «+»."]
	quest.15ECBC8E174FA39B.title: "Беспроводной терминал"
	quest.15ECBC8E174FA39B.quest_desc: ["Позволяет открывать интерфейс хранилища вашей МЭ-сети из любой точки в радиусе действия передатчика."]
	quest.7FA85713C86166DA.title: "Беспроводной монитор автокрафта"
	quest.7FA85713C86166DA.quest_desc: ["Позволяет удаленно следить за текущими задачами автокрафта и отменять их прямо из инвентаря."]
	quest.744842B2AED28344.title: "Беспроводной терминал создания (Wireless Crafting Grid)"
	quest.744842B2AED28344.quest_desc: ["Объединяет функции беспроводного доступа и верстака прямо в ваших руках! Можно крафтить на ходу."]
	quest.66D85424EC74EDCC.title: "Портативный терминал (Portable Grid)"
	quest.66D85424EC74EDCC.quest_desc: ["Переносной блок со встроенной батареей и слотом под один диск хранения. Идеален для походов и экспедиций."]
	quest.12A43F82FC67A289.title: "Дисковод МЭ-сети (Disk Drive)"
	quest.12A43F82FC67A289.quest_desc: ["&9Дисковод&r вмещает до 8 дисков хранения (предметных, жидкостных или химических).", "", "Именно здесь физически хранятся все цифровые данные вашей сети."]
	quest.59F5ED931FD70C55.title: "Шаблоны автокрафта (Patterns)"
	quest.59F5ED931FD70C55.quest_desc: ["Многоразовые носители информации для записи рецептов в Терминале шаблонов. Записанный шаблон помещается в Создатель."]
	quest.64E85274D24FE394.title: "Монитор хранения"
	quest.64E85274D24FE394.quest_desc: ["Настенный дисплей, отображающий точное количество одного выбранного предмета в сети. Кликнув по нему, можно быстро взять или положить стак."]
	quest.6B04FC81351CD1AB.title: "Беспроводной передатчик (Wireless Transmitter)"
	quest.6B04FC81351CD1AB.quest_desc: ["Излучает беспроводной сигнал вокруг себя. Дальность расширяется с помощью улучшений дальности (Range Upgrades)."]
	quest.7604D8B3C9FCCFD9.title: "Корпус диска (Storage Housing)"
	quest.7604D8B3C9FCCFD9.quest_desc: ["Металлическая оболочка для сборки стандартных дисков хранения 1k-64k."]
	quest.3E890BABC4C41370.title: "Сетевой передатчик и приёмник"
	quest.3E890BABC4C41370.quest_desc: ["Позволяют объединять удаленные базы в одну единую сеть без прокладки тысяч блоков кабеля.", "", "Связываются друг с другом с помощью &3Сетевой карты&r (Network Card)."]
	quest.787415570026FFAA.title: "Улучшения «Шелковое касание» и «Удача»"
	quest.787415570026FFAA.quest_desc: ["Устанавливаются в Деструктор для бережного сбора блоков (ульи, спавнеры, стекло) или максимальной добычи руды."]
	quest.2B27E4E04A628C60.title: "Улучшения скорости и стака"
	quest.2B27E4E04A628C60.quest_desc: ["&eУлучшение скорости&r ускоряет работу импортёров, экспортёров и создателей.", "", "&eУлучшение стака&r позволяет перемещать сразу по 64 предмета за одну операцию вместо 1."]
	quest.2E2811D1A0F2A492.title: "Улучшение дальности (Range Upgrade)"
	quest.2E2811D1A0F2A492.quest_desc: ["Увеличивает радиус действия Беспроводного передатчика на 8 блоков за каждое улучшение (до 4 штук в один передатчик)."]
	quest.30700E99091B712A.title: "Улучшения регулятора и автокрафта"
	quest.30700E99091B712A.quest_desc: ["&cУлучшение регулятора&r поддерживает строго заданное количество предметов в целевом сундуке (например, всегда держать ровно 64 угля в топке).", "", "&6Улучшение автокрафта&r заставляет экспортёр заказывать автокрафт нужного предмета, если его нет в сети."]
	quest.7044EAB5EDF32BBC.title: "Монитор автокрафта"
	quest.7044EAB5EDF32BBC.quest_desc: ["Стационарный блок для просмотра всех запущенных очередей автокрафта в сети."]
	quest.1187F9D4F4E0D254.title: "Гаечный ключ Refined Storage"
	quest.1187F9D4F4E0D254.quest_desc: ["Универсальный инструмент: мгновенно снимает приборы сети со всеми настройками без поломки (Shift + ПКМ), а также вращает блоки."]
	quest.22F80D267321BFC5.title: "Менеджер автокрафтеров"
	quest.22F80D267321BFC5.quest_desc: ["Централизованный интерфейс, где собраны все Создатели вашей сети. Позволяет раскладывать и заменять шаблоны в одном окне, не бегая по базе."]
	quest.4A99CAB529BB9F75.title: "Мега-конструктор"
	quest.4A99CAB529BB9F75.quest_desc: ["Максимальный тир конструктора для мгновенной установки блоков."]
	quest.33105698C75093C2.title: "Мега-деструктор"
	quest.33105698C75093C2.quest_desc: ["Максимальный тир деструктора для моментальной добычи любых объемов блоков."]
	quest.5EAD916C4F15335F.title: "Мега-импортёр"
	quest.5EAD916C4F15335F.quest_desc: ["Максимальный тир импортёра. Моментально опустошает сундуки и механизмы."]
	quest.3B062B9EC2CEF592.title: "Мега-экспортёр"
	quest.3B062B9EC2CEF592.quest_desc: ["Максимальный тир экспортёра со скоростью перемещения сотен предметов в тик."]
	quest.5CAC395680027354.title: "Межпространственный передатчик"
	quest.5CAC395680027354.quest_desc: ["Позволяет использовать беспроводные терминалы в любых измерениях (Незер, Энд, Сумеречный Лес, Аэзер) на бесконечном расстоянии!"]
	quest.0945EC53626F58E6.title: "Хранение химикатов Mekanism"
	quest.0945EC53626F58E6.quest_desc: ["Специальный компонент для хранения газов, суспензий и пигментов Mekanism в вашей цифровой сети Refined Storage."]
	quest.24D3F605315ADB03.title: "Универсальный беспроводной терминал"
	quest.24D3F605315ADB03.quest_desc: ["Все-в-одном: переключайтесь между обычным терминалом, терминалом создания, жидкостным терминалом и монитором автокрафта в одном предмете!"]
	quest.23F691FC053F2319.title: "Дисковый интерфейс"
	quest.23F691FC053F2319.quest_desc: ["Позволяет быстро переносить все данные с одного диска на другой, либо передавать содержимое в сеть."]
	quest.723E0CD3C8DD36B1.title: "Элитный дисковый интерфейс"
	quest.723E0CD3C8DD36B1.quest_desc: ["Ускоренная версия дискового интерфейса."]
	quest.723F67A9C6993018.title: "Ультра дисковый интерфейс"
	quest.723F67A9C6993018.quest_desc: ["Высокоскоростная обработка и перезапись дисков."]
	quest.796E922CA69BAE82.title: "Мега дисковый интерфейс"
	quest.796E922CA69BAE82.quest_desc: ["Мгновенный перенос терабайтов данных между накопителями."]
}
