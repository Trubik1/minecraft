				id: "28DB734A99F82FCE"
				type: "kill"
				value: 1L
			}]
			x: 8.0d
			y: -0.5d
					title: "&bГвиб&r"
			description: [ "&bГвибы&r — более крупные и злые версии &bгвиблингов&r. \\n\\nИз них ничего не выпадает, и их нельзя поймать в ведро. Всё, что они предлагают, — это боль!" "{image:atm:textures/questpics/undergarden/undergarden_gwib.png width:100 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
