				id: "68A2E3EFD8C086B8"
				item: { count: 1, id: "undergarden:glitterkelp" }
				type: "item"
			}]
			x: 6.5d
			y: -5.0d
					description: ["Блестящая водоросль растёт в древнем и ледяном морях. \\n\\nОна не делает ничего особенного, только светится и может быть превращена в пирог!"]
		}
