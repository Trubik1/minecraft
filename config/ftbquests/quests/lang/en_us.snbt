	quest.00ACD837E30165B3.quest_desc: ["Consumes FE and outputs mechanical rotation!\n\nUse a wrench to configure target RPM (up to 256 RPM) and direction. Perfect for powering remote factories without water wheels!"]
	quest.00ACD837E30165B3.title: "Electric Motor"
	quest.01F18150EC923482.quest_desc: [
		"Контроллер Refined Storage — это вершина технологического и магического прогресса!"
		""
		"Для его создания вам потребуются компоненты сразу четырех модов:"
		"- &6Create&r: Точный механизм (Precision Mechanism)"
		"- &bMekanism&r: Базовая микросхема и Энергетический планшет"
		"- &dArs Nouveau&r: Самоцвет Источника (Source Gem)"
		"- &aRefined Storage&r: Продвинутые процессоры и Корпус механизма"
	]
	quest.01F18150EC923482.title: "Квантовое Сердце Сети"
	quest.0354DB37FD2030EE.quest_desc: ["Clean liquid fuel for boilers and engines."]
	quest.0354DB37FD2030EE.title: "Bioethanol"
