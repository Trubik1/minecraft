	quest.27F62C4B42B16015.quest_desc: [
		"Постройте рамку 4x5 из светящегося камня и залейте водой, чтобы открыть портал в парящий мир Эфира (Aether)!"
	]
	quest.5825892699A8DCB7.quest_desc: [
		"Небесное облако Эфира. Обладает особыми физическими свойствами: батут, замедление или ускорение движения."
	]
	quest.4BF7F82F1C8680B9.quest_desc: [
		"Реликвия или ключ из подземелий Эфира. Победите босса данжа, чтобы получить легендарную награду!"
	]
	quest.5900ADCC247CD5F9.quest_desc: [
		"Уникальный предмет из парящего измерения Эфира. Поможет в исследовании небесных островов."
	]
	quest.7BFB4DA68A7912E5.quest_desc: [
		"Уникальный предмет из парящего измерения Эфира. Поможет в исследовании небесных островов."
	]
	quest.0483D3B051665F07.quest_desc: [
		"Ценный минерал или священная экипировка Эфира, наделяющая владельца благословением небес."
	]
	quest.1ECAEC7BE573BB9C.quest_desc: [
