	quest.7C94F6AE2A793858.title: "Компонент хранения ExtraDisks 1024k (1M)"
	quest.7C94F6AE2A793858.quest_desc: [
		"Компонент хранения для сборки диска хранения предметов емкостью &61 024 000&r предметов."
		""
