					title: "&cГнильгор&r"
			description: [ "Самый крупный и опасный &cгниль-моб&r. \\n\\nУ них 80 сердец, что, думаю, делает их мини-боссом. \\n\\nКак и все &cгниль-мобы&r, они атакуют &2камнерождённых&r и &7забвенных&r и из них выпадают &cутеритовые осколки&r." "{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "5D229FA3A5F92954"
			rewards: [{
				count: 4
				id: "4F9BB0E1415EF299"
				item: {
					count: 1
					id: "undergarden:froststeel_nugget"
				}
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				entity: "undergarden:muncher"
				id: "775FC64EEBCD72DB"
				type: "kill"
				value: 1L
			}]
			x: 11.0d
			y: -2.0d
					title: "&4Зубастик&r"
			description: [ "&4Зубастики&r похожи на других враждебных мобов в &2&lПодземном саду&r, но их дроп делает их гораздо полезнее! \\n\\nИз зубастика может выпасть &7клоггрум&r и &bморозносталевые самородки&r при смерти." "{image:atm:textures/questpics/undergarden/undergarden_muncher.png width:100 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "4D836B9D9E3B898F"
			rewards: [{
				count: 3
				id: "1F234CCAC2D4F7D9"
				item: {
					count: 1
					id: "undergarden:regalium_crystal"
				}
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				entity: "undergarden:stoneborn"
				id: "6B5ACC22375819D5"
				type: "kill"
				value: 1L
			}]
			x: 0.5d
			y: 1.0d
					title: "&2Камнерождённый&r"
			description: [ "&2Камнерождённые&r — идеальное сочетание жителей и железных големов. \\n\\nС ними можно торговать, кликая правой кнопкой мыши. \\n\\nОни также сражаются с враждебными мобами (или игроками, которые их ударят)." "{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "79C652E3FCB88550"
			rewards: [{
				count: 4
				id: "42738C69450F0A58"
				item: {
					count: 1
					id: "undergarden:raw_gloomper_leg"
				}
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				entity: "undergarden:gloomper"
				id: "1FB5E933DD7FA6F9"
				type: "kill"
				value: 1L
			}]
			x: 0.5d
			y: -2.0d
					title: "&5Мрачнушка&r"
			description: [ "&5Мрачнушки&r технически пассивны, но у них есть защитный механизм, так что я считаю их нейтральными! \\n\\nПри ударе они выпускают эффект, похожий на зелье с остаточным действием. \\n\\nПри смерти их них выпадают их лапки (очень вкусные) и, возможно, кожа. \\n\\nИх также можно разводить с мрачными тыквами!" "{image:atm:textures/questpics/undergarden/undergarden_gloomper.png width:100 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "0A1D6E233C0ECC8E"
			rewards: [{
				id: "39F72DD6F716983D"
				type: "xp"
				xp: 1
			}]
			size: 1.5d
			tasks: [{
				entity: "undergarden:nargoyle"
				id: "241BF9881DEEAA19"
				type: "kill"
				value: 1L
			}]
			x: 9.0d
			y: -2.0d
					title: "&dНаргуль&r"
			description: [ "&dНаргули&r — мерзкие и враждебные мобы, появляющиеся под землёй. \\n\\nУ них 7,5 сердец, и они будут неустанно пытаться вас убить. \\n\\nИх них ничего не выпадает, и они просто мешают тем, кто хочет спокойно добывать ресурсы." "{image:atm:textures/questpics/undergarden/undergarden_nargoyle.png width:100 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "4F3B4990BE6C2A4A"
			rewards: [{
				count: 10
				id: "21A9651456278BCD"
				item: {
					count: 1
					id: "undergarden:goo_ball"
				}
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				entity: "undergarden:scintling"
				id: "01C8E18FB9140B34"
				type: "kill"
				value: 1L
			}]
			x: -2.5d
			y: 1.0d
					title: "&7Сквернослизень&r"
			description: [ "&7Сквернослизни&r — маленькие невинные слизни, встречающиеся повсюду в &2&lПодземном саду&r. \\n\\nОни похожи на снежных големов, оставляют след, куда бы ни ползли. Только этот след более липкий... \\n\\nПри смерти из них выпадает комок сквернослизи, но её можно собирать с их следов, так зачем их убивать!" "{image:atm:textures/questpics/undergarden/undergarden_scintling.png width:150 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "67A2347534269528"
			rewards: [{
				id: "3293B6D906126951"
				type: "xp"
				xp: 1
			}]
			size: 1.5d
			tasks: [{
				entity: "undergarden:sploogie"
				id: "1DB0E7F8AF4D40A8"
				type: "kill"
				value: 1L
			}]
			x: 7.0d
			y: -2.0d
					title: "&9Сплуг&r"
			description: [ "&9Сплуги&r редко появляются, но когда появляются, их цель — раздражать вас. \\n\\nОни плюются в вас (и издают отвратительные хлюпающие звуки), но если ударить их, они убегают, как детёныши пиглинов. \\n\\nПри смерти их них выпадают только глубинные гальки." "{image:atm:textures/questpics/undergarden/undergarden_sploogie.png width:125 height:100 align:center}" ]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "53FDC6C536E50A1A"
			rewards: [{
				id: "4FA496EDE0E9607C"
				item: {
					count: 1
					id: "undergarden:gwibling_bucket"
				}
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				entity: "undergarden:gwibling"
				id: "55DE528A1CC77248"
				type: "kill"
				value: 1L
			}]
			x: -6.5d
			y: -2.0d
					title: "&bГвиблинг&r"
			description: ["&bГвиблинги&r — дружелюбные рыбы в морях. \\n\\nОни меньше, чем &bгвибы&r, и ведут себя, как обычные рыбы из ванильного майнкрафта!"]
		}
		{
			dependencies: ["1C232674CD04024D"]
			id: "71E1454990DEC451"
			rewards: [{
				id: "3E0804953DAAC7E3"
